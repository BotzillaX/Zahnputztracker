{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zahnputztracker",
  "version": "0.1.0",
  "identifier": "de.local.zahnputztracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zahnputztracker",
        "width": 1000,
        "height": 720,
        "resizable": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../service_dist/service": "service/"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/BotzillaX/Zahnputztracker/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3N0NDNzQyMEU5RUYwQTAKUldTZzhKNE9Rc2Q4WnpqRVVVenQrQkdobTN3T2tGbnlBUVNTRzd0eXRlV0tadHkvWFZJYVM1OEwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
